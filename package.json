{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.2.4",
  "description": "DeepSeek Harness 桌面端 — 轻量包装 DSH Web GUI",
  "main": "src/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vvn6d4zg82-byte/dsh-desktop.git"
  },
  "author": "DSH",
  "license": "MIT",
  "scripts": {
    "start": "npm run build:ui && node scripts/run-electron.js",
    "build:ui": "vite build --config ui/vite.config.ts",
    "check:style": "node scripts/check-primer.mjs",
    "test": "node --check src/main.js && node --check src/preload.js && node scripts/test-workbench-crash.mjs",
    "dist": "npm run test && npm run check:style && npm run build:ui && electron-builder --win",
    "publish:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "ui/dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vvn6d4zg82-byte",
        "repo": "dsh-desktop"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
